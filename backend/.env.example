# RE:GEN AI — Environment Configuration
#
# OpenAI API Key (optional — enables AI-powered narrative layer)
# Without this key, RE:GEN AI runs fully on deterministic rule-based analysis.
# All outputs remain valid. OpenAI only enhances the executive summary,
# top-action explanation, and waste recommendations (gpt-4o-mini).
#
# Get a key: https://platform.openai.com/api-keys
#
OPENAI_API_KEY=

# CORS configuration (optional — defaults to Vercel prod + localhost dev)
#
# To allow all origins (not recommended for production):
# ALLOW_ALL_ORIGINS=true
#
# To restrict to specific origins (comma-separated):
# ALLOWED_ORIGINS=https://yourdomain.com,https://staging.yourdomain.com
ALLOW_ALL_ORIGINS=
ALLOWED_ORIGINS=

# Rate limiting (slowapi, 10 req/min per IP on AI/upload endpoints by default)
# Set RATELIMIT_ENABLED=false in .env when running the test suite locally,
# or use the pytest fixture in conftest.py which sets this automatically.
RATELIMIT_ENABLED=true

# Copy this file to .env and fill in your key.
# .env is gitignored — never commit your actual key.
