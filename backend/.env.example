# Offline defaults. Inject production settings through the hosting environment.
REGEN_ENV=
# Supported: offline, ollama, gemini, groq, auto
# Cloud inference requires production mode and request consent.
REGEN_AI_PROVIDER=offline
GEMINI_MODEL=
GEMINI_API_KEY=
DATABASE_URL=
ALLOWED_ORIGINS=
REGEN_AUTH_ISSUER=
REGEN_AUTH_AUDIENCE=
REGEN_AUTH_CERT_FILE=
REGEN_OLLAMA_MODEL=

REGEN_GROQ_MODEL=
GROQ_API_KEY=

# Optional operator-approved market feed. HTTPS JSON list in the reviewed catalogue format.
REGEN_MARKET_EVIDENCE_FILE=
REGEN_MARKET_FEED_URL=
# Opt in only where the deployment has permission for public postal/business lookups.
REGEN_PUBLIC_DISCOVERY=0
REGEN_RESEARCH_CONTACT=

# Public single-source rate retrieval for applicable materials. Off by default.
REGEN_PUBLIC_MARKET_RESEARCH=0
# Optional operator-approved HTTPS structured provider. Sends material labels and optional PIN.
REGEN_MATERIAL_RESEARCH_URL=
# Optional alternative operator-approved OSM endpoints.
REGEN_NOMINATIM_URL=
REGEN_OVERPASS_URL=

# Optional indexed web search for public evidence. Default is disabled.
REGEN_SEARCH_PROVIDER=
# Explicit ordered list, e.g. mwmbl,searxng. Only configured entries are used.
REGEN_SEARCH_PROVIDERS=
REGEN_SEARXNG_URL=
REGEN_BRAVE_API_KEY=
REGEN_TAVILY_API_KEY=
# Comma-separated reviewed publisher domains for strictly formatted indexed rate evidence.
REGEN_SEARCH_RATE_HOSTS=
